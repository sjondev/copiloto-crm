# Copie para .env e preencha. O .env NAO vai para o repositorio.
# cp .env.example .env

# ---------- Banco ----------
POSTGRES_DB=copiloto
POSTGRES_USER=copiloto
POSTGRES_PASSWORD=troque-esta-senha
POSTGRES_PORT=5442

# ---------- Estado compartilhado e fila ----------
# inmemory | redis     — estado de idempotencia, circuit breaker, rate limit
STATE_BACKEND=inmemory
# inmemory | rabbitmq  — fila de ingestao e trabalho em background
QUEUE_BACKEND=inmemory
#
# Por quantas horas um ProviderMessageId fica marcado como ja processado (#67).
# O padrao de 24h espelha a janela de atendimento do WhatsApp; o prazo real de
# reentrega do webhook nao foi verificado na fonte, e por isso isto e variavel.
IDEMPOTENCIA_JANELA_HORAS=24

# Chamadas de analise por usuario, por minuto (#41, #71). O contador vive no
# STATE_BACKEND: com estado local, o limite viraria limite x numero de replicas.
RATE_LIMIT_POR_USUARIO=60
# Por quantas horas uma analise ja paga continua valendo (#34).
CACHE_ANALISE_HORAS=6
#
# Com inmemory a aplicacao roda sozinha, sem Redis nem RabbitMQ: e o padrao,
# usado no desenvolvimento e na demo. Os valores abaixo so importam quando os
# backends acima apontam para redis/rabbitmq, com `--profile distribuido`.

REDIS_PASSWORD=
REDIS_PORT=6389

RABBITMQ_USER=copiloto
RABBITMQ_PASSWORD=
RABBITMQ_PORT=5682
RABBITMQ_UI_PORT=15682

# ---------- Auth ----------
# Gere com: openssl rand -base64 48
JWT_SECRET=
JWT_ISSUER=copiloto
JWT_AUDIENCE=copiloto

# ---------- Fonte de conversa ----------
# fake | waha | cloudapi
CONVERSATION_SOURCE=fake

# Os numeros por onde a EMPRESA fala, separados por virgula — um por aparelho
# conectado (#175). E por esta lista que o sistema decide quem falou em cada
# mensagem: numero que falta aqui tem a fala do proprio vendedor lida como se
# fosse do cliente, e o dossie sai invertido.
#
# Vazio cai no numero da demo. Numero invalido derruba a subida de proposito.
WHATSAPP_NUMERO_EMPRESA=+55 11 3333-4444

# Usado apenas quando CONVERSATION_SOURCE=waha
# ATENCAO: WAHA e uma bridge nao-oficial do WhatsApp Web. Contraria os termos
# de uso da Meta e o risco concreto e o BANIMENTO DO NUMERO. Use somente com
# um chip dedicado, nunca o numero principal da empresa.
WAHA_BASE_URL=http://localhost:3000
WAHA_API_KEY=
WAHA_SESSION=default
WAHA_WEBHOOK_SECRET=

# Usado apenas quando CONVERSATION_SOURCE=cloudapi
CLOUDAPI_PHONE_NUMBER_ID=
CLOUDAPI_ACCESS_TOKEN=
CLOUDAPI_VERIFY_TOKEN=

# ---------- Autenticacao ----------
# Segredo do JWT (#49). Minimo 32 caracteres, e SEM valor padrao: a aplicacao
# nao sobe sem ele. Cair para um segredo embutido daria a impressao de proteger
# enquanto qualquer um forja um token de gestor.
# Gere com: openssl rand -base64 48
# O primeiro gestor, criado na subida SE o banco nao tiver nenhum usuario (#182).
# Sem isto o sistema sobe trancado: a tela pede login e nao ha quem logue.
# Minimo de 12 caracteres na senha — e a conta que enxerga a conversa de todos.
ADMIN_EMAIL=
ADMIN_SENHA=

JWT_SEGREDO=

# ---------- Provedores de modelo ----------
# fake | (provedor real, a definir)
# O FakeProvider responde a partir de arquivos em seed/ e nao usa rede.
# E o padrao: a suite de testes e a demo rodam offline e de graca.
MODEL_PROVIDER=fake

# Onde o FakeProvider procura as respostas gravadas por tarefa.
# Vazio usa seed/respostas/ do repositorio. Em container o conteudo vai para
# outro lugar, entao a chave existe para o caminho nao ficar fixo em codigo.
SEED_RESPOSTAS=

# Onde ficam as camadas C0 dos agentes (prompts/a1-leitura.md e afins).
# Vazio usa prompts/ do repositorio.
PROMPTS_DIR=

# Preencher quando plugar um provedor real.
MODEL_API_KEY=
MODEL_BASE_URL=

# ---------- Orcamento e limites ----------
# Teto mensal de gasto com IA, em BRL. 0 = sem teto (nao recomendado).
AI_MONTHLY_BUDGET_BRL=0
AI_REQUEST_TIMEOUT_MS=8000
AI_MAX_RETRIES=2
CIRCUIT_BREAKER_FAILURE_THRESHOLD=5
CIRCUIT_BREAKER_RESET_SECONDS=30
