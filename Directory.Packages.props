<!--
  Versao de pacote declarada UMA vez, para a solution inteira.

  O motivo e concreto neste projeto: Api e Testes vao referenciar EF Core e
  Npgsql juntos, e versao divergente entre o projeto e o teste dele produz o
  pior tipo de falha — o teste passa e a aplicacao quebra.

  Versoes conferidas no terminal (SDK 9.0.203), nao adotadas de memoria.
-->
<Project>

  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
  </PropertyGroup>

  <ItemGroup>
    <!-- Conferidas em 01/09/2026 via api.nuget.org, nao adotadas de memoria. -->
    <PackageVersion Include="Microsoft.EntityFrameworkCore" Version="9.0.19" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Design" Version="9.0.19" />
    <PackageVersion Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="9.0.4" />
    <!-- SQLite so no projeto de TESTES: e o que deixa a suite conferir o
         mapeamento sem exigir Postgres de pe. -->
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Sqlite" Version="9.0.19" />

    <!-- So a ferramenta de gatilhos (#75) usa. 4.14.0 e a ultima que traz
         alvo net9.0 de verdade; a 5.x so tem net10.0 e netstandard2.0, e cair
         no netstandard num SDK 9 e usar o caminho de compatibilidade sem
         precisar. Conferida em api.nuget.org em 04/09/2026. -->
    <PackageVersion Include="Microsoft.CodeAnalysis.CSharp" Version="4.14.0" />

    <PackageVersion Include="coverlet.collector" Version="6.0.2" />
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="17.12.0" />
    <PackageVersion Include="xunit" Version="2.9.2" />
    <PackageVersion Include="xunit.runner.visualstudio" Version="2.8.2" />
  </ItemGroup>

</Project>
